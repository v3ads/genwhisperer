# ─── Database ─────────────────────────────────────────────────────────────────
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Auth / Sessions ──────────────────────────────────────────────────────────
# 32-byte random secret for JWT signing (64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT (V2 hardening): JWT_SECRET and ENCRYPTION_SECRET MUST be two
# independent random values. V1 had them identical — do not reuse the same
# secret for both in V2.
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS

# ─── Encryption ───────────────────────────────────────────────────────────────
# 64 hex chars (32 bytes) for AES-256-GCM encryption of user OpenRouter keys
# AND Genesis project one-time tokens at rest. MUST differ from JWT_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHARS

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# The canonical URL of the frontend (used in magic-link emails and redirects)
APP_URL=https://genwhisperer.com

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://genwhisperer.com,https://www.genwhisperer.com

# Email address that is auto-promoted to admin on first sign-in.
# V1-only: V2 drops the admin dashboard. Keep for the v1-final rollback branch.
ADMIN_EMAIL=your@email.com

# ─── eStage Knowledge Base (V2 — shared server-side KB key) ───────────────────
# The eStage KB chat endpoint (https://kb.ramihost.cloud/api/v1/chat) is called
# server-side by the agent loop on behalf of every tenant (the AI consults it
# before uncertain Genesis writes). One shared key, never sent to the browser.
ESTAGE_KB_API_KEY=pk_live_REPLACE_ME

# ─── OpenRouter (Platform key for the free trial) ─────────────────────────────
# V2 uses the platform key ONLY for the free trial (2 agent turns, cap tunable
# via system_settings `trial_turn_cap`). Paid users (Starter/Pro) bring their
# own key (stored encrypted per-tenant). Required for the trial to work.
OPENROUTER_PLATFORM_KEY=sk-or-v1-REPLACE_ME

# ─── Stripe (V2 billing — Phase 7a) ───────────────────────────────────────────
# Create the 4 products in the Stripe dashboard, then paste the price ids here:
#   Starter monthly $27, Starter annual $259, Pro monthly $39, Pro annual $374.
STRIPE_SECRET_KEY=sk_live_or_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_STARTER_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_STARTER_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PRO_ANNUAL=price_REPLACE_ME
# Optional: a product-specific Stripe Customer Portal configuration (bpc_...).
# When set, billing management sessions expose only this app's allowed plans.
STRIPE_PORTAL_CONFIGURATION_ID=

# ─── Brevo (Transactional email) ──────────────────────────────────────────────
BREVO_API_KEY=REPLACE_ME
BREVO_SENDER_NAME=Geny
BREVO_SENDER_EMAIL=support@genwhisperer.com

# ─── GetResponse (Marketing / subscriber sync) ────────────────────────────────
GETRESPONSE_API_KEY=REPLACE_ME
# Leave blank — the app auto-creates the "GenWhisperer" list on first run
GETRESPONSE_LIST_ID=
